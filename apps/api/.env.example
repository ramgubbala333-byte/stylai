# ─── Required ─────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string-in-production
DATABASE_URL=postgresql+asyncpg://stylai:stylai_dev_pass@localhost:5432/stylai_db

# ─── Optional ─────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
REDIS_URL=redis://localhost:6379/0

# Storage: "local" for dev, "s3" for production
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage

# AWS S3 (only needed if STORAGE_BACKEND=s3)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_S3_REGION=us-east-1

# LLM narrative layer (optional — set to true to enable)
LLM_ENABLED=false
# ANTHROPIC_API_KEY=

ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
